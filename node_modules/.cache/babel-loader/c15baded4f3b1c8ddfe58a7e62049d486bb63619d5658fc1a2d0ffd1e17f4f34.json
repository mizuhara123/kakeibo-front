{"ast":null,"code":"export default {\n  name: \"Plan\",\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      name: null,\n      fromVisible: false,\n      detailFromVisible: false,\n      form: {},\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      rules: {\n        name: [{\n          required: true,\n          message: 'プラン名を入力してください',\n          trigger: 'blur'\n        }],\n        money: [{\n          required: true,\n          message: '金額を入力してください',\n          trigger: 'blur'\n        }, {\n          pattern: /^\\d+$/,\n          message: '正の整数を入力してください',\n          trigger: 'blur'\n        }],\n        start: [{\n          required: true,\n          message: '開始日を選択してください',\n          trigger: 'blur'\n        }],\n        end: [{\n          required: true,\n          message: '終了日を選択してください',\n          trigger: 'blur'\n        }]\n      },\n      ids: [],\n      detailForm: {}\n    };\n  },\n  created() {\n    this.load(1);\n  },\n  methods: {\n    addPlanDetail(planId) {\n      this.detailFromVisible = true;\n      this.detailForm = {\n        planId: planId\n      };\n    },\n    savePlanDetail() {\n      this.$request.post('/planDetail/add', this.detailForm).then(res => {\n        if (res.code === '200') {\n          this.$message.success('操作が成功しました');\n          this.load(1);\n          this.detailFromVisible = false;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    handleAdd() {\n      this.form = {};\n      this.fromVisible = true;\n    },\n    handleEdit(row) {\n      this.form = JSON.parse(JSON.stringify(row));\n      this.fromVisible = true;\n    },\n    save() {\n      this.$refs.formRef.validate(valid => {\n        if (valid) {\n          this.$request({\n            url: this.form.id ? '/plan/update' : '/plan/add',\n            method: this.form.id ? 'PUT' : 'POST',\n            data: this.form\n          }).then(res => {\n            if (res.code === '200') {\n              this.$message.success('保存に成功しました');\n              this.load(1);\n              this.fromVisible = false;\n            } else {\n              this.$message.error(res.msg);\n            }\n          });\n        }\n      });\n    },\n    del(id) {\n      this.$confirm('削除してもよろしいですか？', '削除の確認', {\n        type: 'warning'\n      }).then(() => {\n        this.$request.delete('/plan/delete/' + id).then(res => {\n          if (res.code === '200') {\n            this.$message.success('操作が成功しました');\n            this.load(1);\n          } else {\n            this.$message.error(res.msg);\n          }\n        });\n      }).catch(() => {});\n    },\n    handleSelectionChange(rows) {\n      this.ids = rows.map(v => v.id);\n    },\n    delBatch() {\n      if (!this.ids.length) {\n        this.$message.warning('データを選択してください');\n        return;\n      }\n      this.$confirm('これらのデータを一括削除してもよろしいですか？', '削除の確認', {\n        type: 'warning'\n      }).then(() => {\n        this.$request.delete('/plan/delete/batch', {\n          data: this.ids\n        }).then(res => {\n          if (res.code === '200') {\n            this.$message.success('操作が成功しました');\n            this.load(1);\n          } else {\n            this.$message.error(res.msg);\n          }\n        });\n      }).catch(() => {});\n    },\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/plan/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          name: this.name\n        }\n      }).then(res => {\n        this.tableData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    reset() {\n      this.name = null;\n      this.load(1);\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    },\n    handleImgSuccess(res) {\n      this.form.cover = res.data;\n    }\n  }\n};","map":{"version":3,"names":["name","data","tableData","pageNum","pageSize","total","fromVisible","detailFromVisible","form","user","JSON","parse","localStorage","getItem","rules","required","message","trigger","money","pattern","start","end","ids","detailForm","created","load","methods","addPlanDetail","planId","savePlanDetail","$request","post","then","res","code","$message","success","error","msg","handleAdd","handleEdit","row","stringify","save","$refs","formRef","validate","valid","url","id","method","del","$confirm","type","delete","catch","handleSelectionChange","rows","map","v","delBatch","length","warning","get","params","list","reset","handleCurrentChange","handleImgSuccess","cover"],"sources":["src/views/manager/Plan.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"search\">\r\n      <el-input placeholder=\"タイトルを入力して検索\" style=\"width: 200px\" v-model=\"name\"></el-input>\r\n      <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"load(1)\">検索</el-button>\r\n      <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">リセット</el-button>\r\n    </div>\r\n\r\n    <div class=\"operation\">\r\n      <el-button type=\"primary\" plain @click=\"handleAdd\">新規作成</el-button>\r\n    </div>\r\n\r\n    <div style=\"margin-top: 10px\" v-if=\"tableData.length\">\r\n      <div>\r\n        <el-row :gutter=\"10\" style=\"margin-bottom: 10px\">\r\n          <el-col v-for=\"item in tableData\" :key=\"item.id\" :span=\"12\" style=\"margin-bottom: 5px\">\r\n            <div style=\"display: flex; align-items: center; cursor: pointer\" class=\"card\" @click=\"$router.push('/planDetail?planId=' + item.id)\">\r\n              <img :src=\"item.cover\" alt=\"\" style=\"width: 80px; height: 80px\">\r\n              <div style=\"flex: 1; margin-left: 15px\">\r\n                <div style=\"margin-bottom: 10px; display: flex; align-items: center\">\r\n                  <el-tag type=\"warning\" v-if=\"item.status === '未开始'\">未開始</el-tag>\r\n                  <el-tag type=\"primary\" v-if=\"item.status === '进行中'\">進行中</el-tag>\r\n                  <el-tag type=\"danger\" v-if=\"item.status === '已结束'\">終了</el-tag>\r\n                  <el-tag type=\"success\" v-if=\"item.status === '已完成'\">完了</el-tag>\r\n                  <div style=\"font-size: 20px; flex: 1; width: 0\" class=\"line1\">{{ item.name }}</div>\r\n                  <div style=\"color: #666; margin-left: 20px; font-size: 13px\"><i class=\"el-icon-date\"></i> {{ item.end }}</div>\r\n                </div>\r\n                <div style=\"margin-bottom: 10px\">\r\n                  <el-progress :percentage=\"item.percent\"></el-progress>\r\n                </div>\r\n                <div style=\"display: flex; align-items: center\">\r\n                  <div style=\"flex: 1; color: #666\">\r\n                    <span><i class=\"el-icon-user\"></i> {{ item.userName }}</span>\r\n                    <span style=\"margin-left: 10px\"><i class=\"el-icon-date\"></i> {{ item.date }}</span>\r\n                  </div>\r\n                  <div style=\"width: 50px\">\r\n                    <el-button type=\"primary\" @click.stop=\"addPlanDetail(item.id)\">貯金する</el-button>\r\n                  </div>\r\n                  <div style=\"flex: 1; text-align: right\">\r\n                    <el-button @click.stop=\"handleEdit(item)\" type=\"text\" style=\"font-size: 13px; color: #2a60c9\"><i class=\"el-icon-edit\"></i> 編集</el-button>\r\n                    <el-button @click.stop=\"del(item.id)\" type=\"text\" style=\"font-size: 13px; color: red\"><i class=\"el-icon-delete\"></i> 削除</el-button>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n      <div class=\"pagination\">\r\n        <el-pagination\r\n          background\r\n          @current-change=\"handleCurrentChange\"\r\n          :current-page=\"pageNum\"\r\n          :page-sizes=\"[5, 10, 20]\"\r\n          :page-size=\"pageSize\"\r\n          layout=\"total, prev, pager, next\"\r\n          :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 追加・編集ダイアログ -->\r\n    <el-dialog title=\"情報\" :visible.sync=\"fromVisible\" width=\"40%\" :close-on-click-modal=\"false\" destroy-on-close>\r\n      <el-form :model=\"form\" label-width=\"100px\" style=\"padding-right: 50px\" :rules=\"rules\" ref=\"formRef\">\r\n        <el-form-item label=\"プラン名\" prop=\"name\">\r\n          <el-input v-model=\"form.name\" placeholder=\"プラン名\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"カバー\" prop=\"cover\">\r\n          <el-upload\r\n            :action=\"$baseUrl + '/files/upload'\"\r\n            :headers=\"{ token: user.token }\"\r\n            list-type=\"picture\"\r\n            :on-success=\"handleImgSuccess\">\r\n            <el-button type=\"primary\">カバーをアップロード</el-button>\r\n          </el-upload>\r\n        </el-form-item>\r\n        <el-form-item label=\"目標金額\" prop=\"money\">\r\n          <el-input v-model=\"form.money\" placeholder=\"目標金額\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"開始日\" prop=\"start\">\r\n          <el-date-picker value-format=\"yyyy-MM-dd\" format=\"yyyy-MM-dd\" v-model=\"form.start\"\r\n                          placeholder=\"開始日を選択\" style=\"width: 100%\"></el-date-picker>\r\n        </el-form-item>\r\n        <el-form-item label=\"終了日\" prop=\"end\">\r\n          <el-date-picker value-format=\"yyyy-MM-dd\" format=\"yyyy-MM-dd\" v-model=\"form.end\"\r\n                          placeholder=\"終了日を選択\" style=\"width: 100%\"></el-date-picker>\r\n        </el-form-item>\r\n      </el-form>\r\n      <div slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"fromVisible = false\">キャンセル</el-button>\r\n        <el-button type=\"primary\" @click=\"save\">確定</el-button>\r\n      </div>\r\n    </el-dialog>\r\n\r\n    <!-- 貯金入力ダイアログ -->\r\n    <el-dialog title=\"貯金\" :visible.sync=\"detailFromVisible\" width=\"30%\" :close-on-click-modal=\"false\" destroy-on-close>\r\n      <el-form :model=\"detailForm\" label-width=\"100px\" style=\"padding-right: 50px\" :rules=\"rules\" ref=\"formRef\">\r\n        <el-form-item label=\"金額\" prop=\"money\">\r\n          <el-input v-model=\"detailForm.money\" placeholder=\"金額\"></el-input>\r\n        </el-form-item>\r\n      </el-form>\r\n      <div slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"detailFromVisible = false\">キャンセル</el-button>\r\n        <el-button type=\"primary\" @click=\"savePlanDetail\">確定</el-button>\r\n      </div>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Plan\",\r\n  data() {\r\n    return {\r\n      tableData: [],\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      name: null,\r\n      fromVisible: false,\r\n      detailFromVisible: false,\r\n      form: {},\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      rules: {\r\n        name: [{ required: true, message: 'プラン名を入力してください', trigger: 'blur' }],\r\n        money: [\r\n          { required: true, message: '金額を入力してください', trigger: 'blur' },\r\n          { pattern: /^\\d+$/, message: '正の整数を入力してください', trigger: 'blur' },\r\n        ],\r\n        start: [{ required: true, message: '開始日を選択してください', trigger: 'blur' }],\r\n        end: [{ required: true, message: '終了日を選択してください', trigger: 'blur' }]\r\n      },\r\n      ids: [],\r\n      detailForm: {}\r\n    }\r\n  },\r\n  created() {\r\n    this.load(1)\r\n  },\r\n  methods: {\r\n    addPlanDetail(planId) {\r\n      this.detailFromVisible = true\r\n      this.detailForm = { planId: planId }\r\n    },\r\n    savePlanDetail() {\r\n      this.$request.post('/planDetail/add', this.detailForm).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('操作が成功しました')\r\n          this.load(1)\r\n          this.detailFromVisible = false\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    handleAdd() {\r\n      this.form = {}\r\n      this.fromVisible = true\r\n    },\r\n    handleEdit(row) {\r\n      this.form = JSON.parse(JSON.stringify(row))\r\n      this.fromVisible = true\r\n    },\r\n    save() {\r\n      this.$refs.formRef.validate((valid) => {\r\n        if (valid) {\r\n          this.$request({\r\n            url: this.form.id ? '/plan/update' : '/plan/add',\r\n            method: this.form.id ? 'PUT' : 'POST',\r\n            data: this.form\r\n          }).then(res => {\r\n            if (res.code === '200') {\r\n              this.$message.success('保存に成功しました')\r\n              this.load(1)\r\n              this.fromVisible = false\r\n            } else {\r\n              this.$message.error(res.msg)\r\n            }\r\n          })\r\n        }\r\n      })\r\n    },\r\n    del(id) {\r\n      this.$confirm('削除してもよろしいですか？', '削除の確認', { type: 'warning' }).then(() => {\r\n        this.$request.delete('/plan/delete/' + id).then(res => {\r\n          if (res.code === '200') {\r\n            this.$message.success('操作が成功しました')\r\n            this.load(1)\r\n          } else {\r\n            this.$message.error(res.msg)\r\n          }\r\n        })\r\n      }).catch(() => {})\r\n    },\r\n    handleSelectionChange(rows) {\r\n      this.ids = rows.map(v => v.id)\r\n    },\r\n    delBatch() {\r\n      if (!this.ids.length) {\r\n        this.$message.warning('データを選択してください')\r\n        return\r\n      }\r\n      this.$confirm('これらのデータを一括削除してもよろしいですか？', '削除の確認', { type: 'warning' }).then(() => {\r\n        this.$request.delete('/plan/delete/batch', { data: this.ids }).then(res => {\r\n          if (res.code === '200') {\r\n            this.$message.success('操作が成功しました')\r\n            this.load(1)\r\n          } else {\r\n            this.$message.error(res.msg)\r\n          }\r\n        })\r\n      }).catch(() => {})\r\n    },\r\n    load(pageNum) {\r\n      if (pageNum) this.pageNum = pageNum\r\n      this.$request.get('/plan/selectPage', {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          name: this.name,\r\n        }\r\n      }).then(res => {\r\n        this.tableData = res.data?.list\r\n        this.total = res.data?.total\r\n      })\r\n    },\r\n    reset() {\r\n      this.name = null\r\n      this.load(1)\r\n    },\r\n    handleCurrentChange(pageNum) {\r\n      this.load(pageNum)\r\n    },\r\n    handleImgSuccess(res) {\r\n      this.form.cover = res.data\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n</style>\r\n"],"mappings":"AA8GA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAL,IAAA;MACAM,WAAA;MACAC,iBAAA;MACAC,IAAA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,KAAA;QACAd,IAAA;UAAAe,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAC,KAAA,GACA;UAAAH,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,GACA;UAAAE,OAAA;UAAAH,OAAA;UAAAC,OAAA;QAAA,EACA;QACAG,KAAA;UAAAL,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAI,GAAA;UAAAN,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;MACAK,GAAA;MACAC,UAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAC,cAAAC,MAAA;MACA,KAAArB,iBAAA;MACA,KAAAgB,UAAA;QAAAK,MAAA,EAAAA;MAAA;IACA;IACAC,eAAA;MACA,KAAAC,QAAA,CAAAC,IAAA,yBAAAR,UAAA,EAAAS,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAX,IAAA;UACA,KAAAlB,iBAAA;QACA;UACA,KAAA4B,QAAA,CAAAE,KAAA,CAAAJ,GAAA,CAAAK,GAAA;QACA;MACA;IACA;IACAC,UAAA;MACA,KAAA/B,IAAA;MACA,KAAAF,WAAA;IACA;IACAkC,WAAAC,GAAA;MACA,KAAAjC,IAAA,GAAAE,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAgC,SAAA,CAAAD,GAAA;MACA,KAAAnC,WAAA;IACA;IACAqC,KAAA;MACA,KAAAC,KAAA,CAAAC,OAAA,CAAAC,QAAA,CAAAC,KAAA;QACA,IAAAA,KAAA;UACA,KAAAjB,QAAA;YACAkB,GAAA,OAAAxC,IAAA,CAAAyC,EAAA;YACAC,MAAA,OAAA1C,IAAA,CAAAyC,EAAA;YACAhD,IAAA,OAAAO;UACA,GAAAwB,IAAA,CAAAC,GAAA;YACA,IAAAA,GAAA,CAAAC,IAAA;cACA,KAAAC,QAAA,CAAAC,OAAA;cACA,KAAAX,IAAA;cACA,KAAAnB,WAAA;YACA;cACA,KAAA6B,QAAA,CAAAE,KAAA,CAAAJ,GAAA,CAAAK,GAAA;YACA;UACA;QACA;M